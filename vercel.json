{
    "buildCommand": "cd frontend && npm install && npm run build",
    "outputDirectory": "frontend/dist",
    "rewrites": [
        {
            "source": "/api/test",
            "destination": "/api/test.py"
        },
        {
            "source": "/api/debug",
            "destination": "/api/debug.py"
        },
        {
            "source": "/api/(.*)",
            "destination": "/backend/main.py"
        },
        {
            "source": "/((?!api).*)",
            "destination": "/index.html"
        }
    ]
}