{
    "version": 2,
    "buildCommand": "cd frontend && npm install --legacy-peer-deps && npm run build",
    "outputDirectory": "frontend/dist",
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/$1" },
        { "source": "/((?!api/).*)", "destination": "/index.html" }
    ],
    "env": {
        "VITE_BUILD_TIME": "2026-04-02"
    }
}
