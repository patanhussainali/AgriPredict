# Vercel Ignore File
# Overrides .gitignore for deployment

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Node
node_modules/
frontend/node_modules/

# OS / IDE
.DS_Store
.idea/
.vscode/

# NOTICE: We specifically DO NOT ignore 'dist' or 'frontend/dist' here.
# This ensures the build output is captured by Vercel.
